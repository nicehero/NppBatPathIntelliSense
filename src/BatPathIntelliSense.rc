// Version resource for the plugin DLL.
//
// This file is the single source of truth for the plugin version. package.bat
// reads the version back out of the built DLL, so the JSON entry it prints can
// never drift from the binary.
//
// nppPluginList's validator reads FileVersionMS/FileVersionLS and compares the
// result to the "version" field in pl.x64.json, padding the JSON value with
// ".0" up to four components. So the four-part FILEVERSION below must equal the
// JSON version padded to four parts -- e.g. JSON "0.1.0" <=> FILEVERSION 0,1,0,0.
//
// Keep this file ASCII-only: rc.exe reads it in the system codepage.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "nicehero"
            VALUE "FileDescription",  "BAT Path IntelliSense - file and directory path completion for .bat/.cmd files"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "BatPathIntelliSense"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "BatPathIntelliSense.dll"
            VALUE "ProductName",      "BAT Path IntelliSense"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
